rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'eddylinho04@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'coins',
          'bonusClaimed',
          'lastBonusDate',
          'elo',
          'wins',
          'matchesPlayed',
          'earnings',
          'equippedDice',
          'equippedToken',
          'equippedBoard',
          'unlockedIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'coins',
          'bonusClaimed',
          'lastBonusDate',
          'elo',
          'wins',
          'matchesPlayed',
          'earnings',
          'equippedDice',
          'equippedToken',
          'equippedBoard',
          'unlockedIds',
          'isSuspended',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
        data.email is string && data.email.size() <= 120 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.coins is int && data.coins >= 0 && data.coins <= 10000000 &&
        data.bonusClaimed is bool &&
        data.lastBonusDate is string && data.lastBonusDate.size() <= 20 &&
        data.elo is int && data.elo >= 0 && data.elo <= 100000 &&
        data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
        data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 1000000 &&
        data.earnings is int && data.earnings >= 0 && data.earnings <= 100000000 &&
        data.equippedDice in ['obsidian-glass', 'solar-amber', 'cyber-prism'] &&
        data.equippedToken in ['arcade-chip', 'carbon-ring', 'royal-crown'] &&
        data.equippedBoard in ['midnight-obsidian', 'cobalt-vault', 'emerald-circuit'] &&
        data.unlockedIds is list && data.unlockedIds.size() >= 1 && data.unlockedIds.size() <= 30 &&
        data.unlockedIds[0] is string && data.unlockedIds[0].size() <= 64 &&
        (!('isSuspended' in data) || data.isSuspended is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidTokenPurchase(data, userId) {
      return data.keys().hasAll([
          'uid',
          'itemId',
          'itemName',
          'category',
          'price',
          'balanceAfter',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'itemId',
          'itemName',
          'category',
          'price',
          'balanceAfter',
          'createdAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 64 &&
        data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 80 &&
        data.category in ['token', 'dice', 'board', 'coins-pack'] &&
        data.price is int && data.price >= 0 && data.price <= 1000000 &&
        data.balanceAfter is int && data.balanceAfter >= 0 && data.balanceAfter <= 10000000 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidRoomHistory(data, userId) {
      return data.keys().hasAll([
          'uid',
          'roomCode',
          'mode',
          'role',
          'myColor',
          'stake',
          'wagerPot',
          'outcome',
          'netChange',
          'winnerName',
          'playerCount',
          'opponents',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'roomCode',
          'mode',
          'role',
          'myColor',
          'stake',
          'wagerPot',
          'outcome',
          'netChange',
          'winnerName',
          'playerCount',
          'opponents',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.roomCode is string && data.roomCode.size() >= 1 && data.roomCode.size() <= 20 &&
        data.mode in ['online', 'quick-4p', 'duel-2p', 'pass-play'] &&
        data.role in ['host', 'guest', 'solo'] &&
        data.myColor in ['red', 'green', 'yellow', 'blue'] &&
        data.stake is int && data.stake >= 0 && data.stake <= 1000000 &&
        data.wagerPot is int && data.wagerPot >= 0 && data.wagerPot <= 4000000 &&
        data.outcome in ['win', 'loss', 'joined', 'abandoned'] &&
        data.netChange is int && data.netChange >= -1000000 && data.netChange <= 4000000 &&
        data.winnerName is string && data.winnerName.size() <= 50 &&
        data.playerCount is int && data.playerCount >= 2 && data.playerCount <= 4 &&
        data.opponents is list && data.opponents.size() <= 4 &&
        (data.opponents.size() == 0 || (data.opponents[0] is string && data.opponents[0].size() <= 50)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidWalletTx(data, userId) {
      return data.keys().hasAll([
          'uid',
          'txType',
          'amount',
          'balanceAfter',
          'label',
          'referenceCode',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'txType',
          'amount',
          'balanceAfter',
          'label',
          'referenceCode',
          'createdAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.txType in [
          'stake_debit',
          'pot_win',
          'shop_purchase',
          'topup',
          'daily_bonus',
          'initial_grant',
          'coin_buy',
          'coin_sell',
          'coin_refund',
          'admin_adjust'
        ] &&
        data.amount is int && data.amount >= -10000000 && data.amount <= 10000000 &&
        data.balanceAfter is int && data.balanceAfter >= 0 && data.balanceAfter <= 10000000 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.referenceCode is string && data.referenceCode.size() <= 32 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidPublicStanding(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'elo',
          'wins',
          'matchesPlayed',
          'earnings',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'elo',
          'wins',
          'matchesPlayed',
          'earnings',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.elo is int && data.elo >= 0 && data.elo <= 100000 &&
        data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
        data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 1000000 &&
        data.earnings is int && data.earnings >= 0 && data.earnings <= 100000000 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidShopOrder(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'orderType',
          'coinsAmount',
          'fiatCents',
          'currency',
          'paymentMethod',
          'payoutDetails',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'orderType',
          'coinsAmount',
          'fiatCents',
          'currency',
          'paymentMethod',
          'payoutDetails',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
        data.orderType in ['buy', 'sell'] &&
        data.coinsAmount is int && data.coinsAmount >= 1 && data.coinsAmount <= 10000000 &&
        data.fiatCents is int && data.fiatCents >= 0 && data.fiatCents <= 100000000 &&
        data.currency in ['EUR', 'USD', 'XOF'] &&
        data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40 &&
        data.payoutDetails is string && data.payoutDetails.size() <= 120 &&
        data.status in ['pending', 'completed', 'rejected'] &&
        data.adminNote is string && data.adminNote.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll([
          'maintenanceMode',
          'shopBuyEnabled',
          'shopSellEnabled',
          'instantBuyCredit',
          'buyRatePer1000Cents',
          'sellRatePer1000Cents',
          'currency',
          'minSellCoins',
          'dailyBonusCoins',
          'maxStake',
          'announcement',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'maintenanceMode',
          'shopBuyEnabled',
          'shopSellEnabled',
          'instantBuyCredit',
          'buyRatePer1000Cents',
          'sellRatePer1000Cents',
          'currency',
          'minSellCoins',
          'dailyBonusCoins',
          'maxStake',
          'announcement',
          'updatedAt'
        ]) &&
        data.maintenanceMode is bool &&
        data.shopBuyEnabled is bool &&
        data.shopSellEnabled is bool &&
        data.instantBuyCredit is bool &&
        data.buyRatePer1000Cents is int && data.buyRatePer1000Cents >= 1 && data.buyRatePer1000Cents <= 10000000 &&
        data.sellRatePer1000Cents is int && data.sellRatePer1000Cents >= 1 && data.sellRatePer1000Cents <= 10000000 &&
        data.currency in ['EUR', 'USD', 'XOF'] &&
        data.minSellCoins is int && data.minSellCoins >= 1 && data.minSellCoins <= 1000000 &&
        data.dailyBonusCoins is int && data.dailyBonusCoins >= 0 && data.dailyBonusCoins <= 100000 &&
        data.maxStake is int && data.maxStake >= 0 && data.maxStake <= 10000000 &&
        data.announcement is string && data.announcement.size() <= 200 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAdminDoc(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin() && resource.data.uid is string;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (!('isSuspended' in incoming()) || incoming().isSuspended == false) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt && (
          (isOwner(userId) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'bonusClaimed', 'lastBonusDate', 'elo', 'wins', 'matchesPlayed', 'earnings', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'unlockedIds', 'equippedDice', 'equippedToken', 'equippedBoard', 'updatedAt'])
          )) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'elo', 'wins', 'matchesPlayed', 'earnings', 'isSuspended', 'updatedAt']))
        );
      allow delete: if false;

      match /tokenPurchases/{purchaseId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(purchaseId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin()) && resource.data.uid == userId;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(purchaseId) &&
          isOwner(userId) &&
          userExists(userId) &&
          isValidTokenPurchase(incoming(), userId);
        allow update, delete: if false;
      }

      match /roomHistory/{historyId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(historyId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin()) && resource.data.uid == userId;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(historyId) &&
          isOwner(userId) &&
          userExists(userId) &&
          isValidRoomHistory(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(historyId) &&
          isOwner(userId) &&
          userExists(userId) &&
          isValidRoomHistory(incoming(), userId) &&
          existing().outcome == 'joined' &&
          incoming().uid == existing().uid &&
          incoming().roomCode == existing().roomCode &&
          incoming().mode == existing().mode &&
          incoming().role == existing().role &&
          incoming().myColor == existing().myColor &&
          incoming().stake == existing().stake &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'outcome',
            'wagerPot',
            'netChange',
            'winnerName',
            'playerCount',
            'opponents',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      match /walletTransactions/{txId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin()) && resource.data.uid == userId;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(txId) &&
          (isOwner(userId) || isAdmin()) &&
          userExists(userId) &&
          isValidWalletTx(incoming(), userId);
        allow update, delete: if false;
      }
    }

    match /leaderboardPublic/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.elo >= 0;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidPublicStanding(incoming(), userId);
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidPublicStanding(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'elo',
          'wins',
          'matchesPlayed',
          'earnings',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /shopOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        incoming().uid == request.auth.uid &&
        userExists(request.auth.uid) &&
        isValidShopOrder(incoming()) &&
        incoming().createdAt == request.time &&
        (incoming().status == 'pending' || (incoming().orderType == 'buy' && incoming().status == 'completed'));
      allow update: if isAdmin() &&
        isValidId(orderId) &&
        isValidShopOrder(incoming()) &&
        existing().status == 'pending' &&
        incoming().uid == existing().uid &&
        incoming().orderType == existing().orderType &&
        incoming().coinsAmount == existing().coinsAmount &&
        incoming().fiatCents == existing().fiatCents &&
        incoming().currency == existing().currency &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if false;
    }

    match /platformConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && configId == 'settings';
      allow list: if false;
      allow create, update: if isAdmin() &&
        isValidId(configId) &&
        configId == 'settings' &&
        isValidPlatformSettings(incoming());
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin() && resource.data.uid is string;
      allow create: if isAdmin() &&
        isValidId(userId) &&
        isValidAdminDoc(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }
  }
}
